{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 30,
            "statusMessage": "세션 브랜치 생성 중..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto-commit.sh",
            "timeout": 60,
            "statusMessage": "lint 검사 및 자동 커밋 중..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-branch.sh",
            "statusMessage": "브랜치 보호 검사 중..."
          },
          {
            "type": "command",
            "if": "Edit(**/.env)|Write(**/.env)",
            "command": "echo '.env 파일은 수정할 수 없습니다. 사용자에게 직접 수정을 요청하세요.' >&2 && exit 2",
            "statusMessage": ".env 보호 검사 중..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-compact.sh",
            "timeout": 10,
            "statusMessage": "압축 후 핵심 규칙 재주입 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-lint.sh",
            "timeout": 30,
            "statusMessage": "파일 lint 검사 중..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-merge.sh",
            "timeout": 10,
            "statusMessage": "머지 감지 검사 중..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(**/.env)",
      "Write(**/.env)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git push)"
    ]
  }
}
