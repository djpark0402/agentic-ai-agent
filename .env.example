# ============================================================================
# 환경 변수 예시 — 실제 사용 시 .env로 복사 후 값 채워주세요
# .env 파일은 절대 커밋하지 마세요 (.gitignore에 포함)
# ============================================================================

# --- PostgreSQL (docker-compose.yml과 동일 값 사용) ---
POSTGRES_DB=agentic_ai
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic_dev_pw
POSTGRES_PORT=5432

# Backend에서 DB 연결 시 사용. docker-compose가 localhost:5432에 바인딩
DATABASE_URL=postgresql+asyncpg://agentic:agentic_dev_pw@localhost:5432/agentic_ai

# Alembic(동기) 전용 URL — asyncpg 드라이버 접두사 제거
SYNC_DATABASE_URL=postgresql://agentic:agentic_dev_pw@localhost:5432/agentic_ai

# --- LLM ---
BASE_URL=http://10.47.18.100:8000/v1
API_KEY=
HMAC_SECRET=
LLM_MODEL=solar-pro3-260323
